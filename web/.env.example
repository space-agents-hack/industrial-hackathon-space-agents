# Supabase API URL. Local: the API_URL line of `supabase status -o env` (http://127.0.0.1:54421).
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Local: the PUBLISHABLE_KEY line of `supabase status -o env`. Never the secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL of the agent service, no trailing slash. Server only. Local: http://127.0.0.1:8000
AGENT_URL=
# Shared secret sent to the agent as a bearer token. Server only. Must equal the agent's own value.
AGENT_SHARED_SECRET=
