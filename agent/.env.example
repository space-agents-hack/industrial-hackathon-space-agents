# Copy to agent/.env for local work (`make setup` writes it for you). In production these are
# environment variables of the agent's Vercel project.

# Which model runs the agent, as provider:model. Changing provider is this line plus its key.
#   scripted                        no provider, no key: plays the example task (default)
#   anthropic:claude-opus-5-5       needs ANTHROPIC_API_KEY
#   openai:gpt-5.2                  needs OPENAI_API_KEY
#   openrouter:anthropic/claude-sonnet-4.6   needs OPENROUTER_API_KEY
#   deepseek:deepseek-v4-flash      needs DEEPSEEK_API_KEY
AGENT_MODEL=scripted

# Shared with the web server (same value as AGENT_SHARED_SECRET in web/.env.local).
# Generate one with: openssl rand -hex 32
AGENT_SHARED_SECRET=

# The Supabase project. The secret key bypasses row-level security: it belongs here and nowhere
# in web/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Only the key for the provider in AGENT_MODEL is needed.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# Optional limits (defaults shown). See agent_service/settings.py for why each exists.
# RUN_TIMEOUT_S=270
# MAX_MODEL_REQUESTS=30
