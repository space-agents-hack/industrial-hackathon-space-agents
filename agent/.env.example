# Copy to agent/.env for local work (`make setup` writes it for you). In production these are
# environment variables of the agent's Vercel project.

# Which model runs the agent, as provider:model. Changing provider is this line plus its key.
# This is the default: an organisation can choose its own model in Admin, Models and limits.
#   scripted                        no provider, no key: plays the example task (default)
#   anthropic:claude-opus-5-5       needs ANTHROPIC_API_KEY
#   openai:gpt-5.2                  needs OPENAI_API_KEY
#   openrouter:anthropic/claude-sonnet-4.6   needs OPENROUTER_API_KEY
#   deepseek:deepseek-v4-flash      needs DEEPSEEK_API_KEY
#   ollama:qwen3:32b                needs OLLAMA_BASE_URL (your own server, no key)
AGENT_MODEL=scripted

# Shared with the web server (same value as AGENT_SHARED_SECRET in web/.env.local).
# Generate one with: openssl rand -hex 32
AGENT_SHARED_SECRET=

# The Supabase project. The secret key bypasses row-level security: it belongs here and nowhere
# in web/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Only the key for the provider in AGENT_MODEL is needed. An organisation that connects its own key
# in Admin, Providers uses that one instead; these are the fallback for the others.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# The OpenAI-compatible path of an Ollama server this agent can reach, e.g. http://localhost:11434/v1.
# An organisation that connects its server in Admin, Providers uses that one instead.
# OLLAMA_BASE_URL=

# Regulation search (make regulations-index). Vectors need an OpenAI key (the organisation's or
# OPENAI_API_KEY above) even when AGENT_MODEL is another provider. "openrouter:openai/..." uses
# OPENROUTER_API_KEY instead. Changing the model embeds the whole library again.
# EMBEDDING_MODEL=openai:text-embedding-3-small
# Writes one scope summary per regulation version; unset uses AGENT_MODEL. Not "scripted".
# SUMMARY_MODEL=

# Optional limits (defaults shown). See agent_service/settings.py for why each exists.
# RUN_TIMEOUT_S=270
# MAX_MODEL_REQUESTS=30
# SUBAGENT_TIMEOUT_S=240
# Monthly spending cap per organisation in USD, counted from the cost recorded on each run. Unset
# means no cap. An organisation's own cap (Admin, Models and limits) replaces it.
# MONTHLY_COST_CAP_USD=
