{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "agent",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--project", "agent", "--directory", "agent", "uvicorn", "main:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
